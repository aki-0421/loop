{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop.dev/schemas/run-state.schema.json",
  "title": "loop run state",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "base_branch",
    "agent",
    "current_iteration",
    "stage",
    "iterations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "base_branch": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "default": "codex"
    },
    "current_iteration": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "created",
        "branch_created",
        "agent_running",
        "validating",
        "integrating",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "iteration_id",
          "branch_initial",
          "stage"
        ],
        "properties": {
          "iteration_id": {
            "type": "string"
          },
          "branch_initial": {
            "type": "string"
          },
          "branch_current": {
            "type": "string"
          },
          "branch_final": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "result_path": {
            "type": "string"
          },
          "summary_sentence": {
            "type": "string"
          },
          "should_fully_stop": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
