{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop.dev/schemas/loop.config.schema.json",
  "title": "loop config",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "language": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "default": "en"
        },
        "allowSkillOverride": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "default": "codex"
        },
        "adapters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/adapter"
          }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "repairAttempts": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "additionalProperties": true
    },
    "git": {
      "type": "object",
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "integration": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "local_merge",
                "pr"
              ],
              "default": "local_merge"
            },
            "local_merge": {
              "type": "object",
              "properties": {
                "squash": {
                  "type": "boolean",
                  "default": true
                },
                "deleteBranch": {
                  "type": "boolean",
                  "default": true
                }
              },
              "additionalProperties": false
            },
            "pr": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean",
                  "default": false
                },
                "push": {
                  "type": "boolean",
                  "default": true
                },
                "waitChecks": {
                  "type": "boolean",
                  "default": true
                },
                "checksRequiredOnly": {
                  "type": "boolean",
                  "default": false
                },
                "checksStartupDelaySeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 5
                },
                "checksDiscoveryTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 60
                },
                "checksPollIntervalSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 5
                },
                "checksWatchTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 3600
                },
                "mergeWhenChecksPass": {
                  "type": "boolean",
                  "default": true
                },
                "deleteBranch": {
                  "type": "boolean",
                  "default": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "additionalProperties": true
    },
    "logs": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "prompt": {
          "enum": [
            "stdin",
            "arg"
          ],
          "default": "stdin"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
